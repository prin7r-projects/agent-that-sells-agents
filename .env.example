# Public app URL used in NOWPayments callback URLs and redirects.
NEXT_PUBLIC_APP_URL=https://agent-that-sells-agents.prin7r.com

# NOWPayments hosted invoice (USDT/USDC). Live keys live only in the deployed .env on storage-contabo.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Settlement wallets — referenced by the catalog FAQ; not used in the API yet.
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=

# Reown / WalletConnect Cloud (direct-wallet fallback, stubbed for now).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Plisio backup invoice (stubbed).
PLISIO_API_KEY=
