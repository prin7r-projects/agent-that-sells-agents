# Public app URL used in NOWPayments callback URLs and redirects.
NEXT_PUBLIC_APP_URL=https://agent-that-sells-agents.prin7r.com

# NOWPayments hosted invoice (USDT/USDC). Live keys live only in the deployed .env on storage-contabo.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Shared secret guarding /api/internal/ipn (PRI-3800). The verified NOWPayments
# webhook handler sends it as `Authorization: Bearer <secret>`; the internal
# fulfillment endpoint rejects any request without it (401). MUST be set in prod
# or fulfillment is disabled (safe-fallback). Use a long random value.
INTERNAL_IPN_SECRET=

# Settlement wallets — referenced by the catalog FAQ; not used in the API yet.
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=

# Reown / WalletConnect Cloud (direct-wallet fallback, stubbed for now).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Plisio backup invoice (stubbed).
PLISIO_API_KEY=

# PostgreSQL (Phase 3+). Auto-wired in docker-compose; set DB_PASSWORD in production .env.
DATABASE_URL=postgresql://stampedagents:stampedagents_dev@postgres:5432/stampedagents
DB_PASSWORD=stampedagents_dev

# Redis for BullMQ queues (eval-runner, digest-runner). Auto-wired in docker-compose.
REDIS_URL=redis://redis:6379

# Admin API key for /api/admin/* endpoints. Rotate every 90 days.
ADMIN_API_KEY=

# Postmark / Resend API key for transactional email (Phase 3).
POSTMARK_API_KEY=

# Notion integration token for order sync (Phase 3).
NOTION_TOKEN=

# Slack incoming webhook URL for operational alerts (sig failures, checkout latency, daily order anomalies).
# Posts to #alerts-stampedagents. Leave unset to disable alerting.
SLACK_WEBHOOK_URL_ALERTS=
